# NeuroLinea API - environment template.
# Copy to server/.env for local development. NEVER commit real values.
# In production, set these in the hosting provider's secret/env settings.

# --- Required -------------------------------------------------------------
# MongoDB connection string (Atlas or self-hosted). Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# JWT signing secret: at least 32 random characters. Generate with e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-long-random-secret>

# Comma-separated list of browser origins allowed to call the API / Socket.io.
CLIENT_URL=https://neurolinea.vercel.app

# --- Recommended ----------------------------------------------------------
NODE_ENV=production
PORT=5003

# Google Gemini API key (AI tutor, case analysis, smart search).
GEMINI_API_KEY=<gemini-api-key>

# Cloudinary (persistent uploads). If unset, uploads go to local disk,
# which is EPHEMERAL on most PaaS hosts.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
